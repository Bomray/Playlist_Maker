# Copier ce fichier en .env.local et le remplir. Ne jamais committer .env.local.

# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
# Facultatif : s'il est défini, l'app s'authentifie en Basic auprès de
# accounts.spotify.com ; sinon elle utilise le flux PKCE seul (client_id dans le
# corps). En session cloud, il n'existe pas : le proxy ajoute l'en-tête Basic.
SPOTIFY_CLIENT_SECRET=
# Doit être déclarée à l'identique dans le dashboard Spotify (Redirect URIs).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Clé de chiffrement des cookies de session (32 caractères minimum).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# SoundCloud (nécessite une app officielle, donc un abonnement Artist Pro)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
